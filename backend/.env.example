APP_NAME="GOLU AI Backend"
APP_VERSION=1.1.0
ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://golu_user:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/golu_db

# Redis connection string (optional caching, rate limiting & background worker queue)
REDIS_URL=redis://localhost:6379/0

# Secrets (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_RANDOM_APP_SECRET
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_RANDOM_JWT_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_EXPIRE_MINUTES=60

# AI Provider settings (kept strictly on backend, never inside Android APK)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=25.0

# Optional SMTP email delivery for password reset & verification (leave blank if unconfigured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Security & Rate Limiting
CORS_ALLOWED_ORIGINS=https://your-domain.example.com
LOGIN_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_SIZE_BYTES=1048576
